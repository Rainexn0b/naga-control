#!/usr/bin/env bash
# AppRun dispatcher for the Naga Control AppImage.
set -u
HERE="$(dirname "$(readlink -f "${APPIMAGE:-$0}")")"
APPDIR="${APPDIR:-$HERE}"

PYLIB="$(ls -d "$APPDIR"/usr/lib/python3.* 2>/dev/null | head -n 1)"
PYTHON="$APPDIR/usr/bin/python3"

export PYTHONHOME="$APPDIR/usr"
export LD_LIBRARY_PATH="$APPDIR/usr/lib${PYLIB:+:$PYLIB/site-packages/PySide6/Qt/lib}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PATH="$APPDIR/usr/bin:$PATH"
export QT_PLUGIN_PATH="${QT_PLUGIN_PATH:-}"
export PYTHONNOUSERSITE=1
export PYTHONSAFEPATH=1
unset PYTHONPATH
export APPDIR

# The host client imports daemon macro/keyboard helpers, but never starts a daemon
# here. Expose just these packages, not host site-packages or native bindings.
LINK_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/naga-control/host-openrazer"
for PACKAGE in openrazer openrazer_daemon; do
  HOST_PACKAGE="$(env -u PYTHONHOME -u PYTHONPATH -u LD_LIBRARY_PATH /usr/bin/python3 -c 'import importlib.util, sys; spec = importlib.util.find_spec(sys.argv[1]); print(next(iter(spec.submodule_search_locations))) if spec and spec.submodule_search_locations else None' "$PACKAGE" 2>/dev/null || true)"
  if [ -n "$HOST_PACKAGE" ]; then
    mkdir -p "$LINK_DIR" || exit 1
    # Atomic replacement avoids following/racing another launcher's package link.
    LINK_TMP="$(mktemp "$LINK_DIR/.$PACKAGE.XXXXXX")" || exit 1
    if ! ln -sfnT "$HOST_PACKAGE" "$LINK_TMP" || ! mv -Tf "$LINK_TMP" "$LINK_DIR/$PACKAGE"; then
      rm -f "$LINK_TMP"
      exit 1
    fi
    export PYTHONPATH="$LINK_DIR"
  fi
done

command="${1:-gui}"
case "$command" in
  gui)
    shift 2>/dev/null || true
    exec "$PYTHON" -m naga_control.gui.app "$@"
    ;;
  service)
    shift 2>/dev/null || true
    exec "$PYTHON" -m naga_control.service.service_cli "$@"
    ;;
  capture)
    shift 2>/dev/null || true
    exec "$PYTHON" -m naga_control.diagnostics.capture_cli "$@"
    ;;
  integration|--install|--uninstall)
    case "$command" in
      --install)
        shift
        set -- install --exec-prefix "${APPIMAGE:-$0}" "$@"
        ;;
      --uninstall)
        shift
        set -- remove "$@"
        ;;
      *)
        shift
        ;;
    esac
    exec "$PYTHON" -m naga_control.integration_cli "$@"
    ;;
  python)
    shift 2>/dev/null || true
    exec "$PYTHON" "$@"
    ;;
  *)
    exec "$PYTHON" -m naga_control.gui.app "$@"
    ;;
esac
